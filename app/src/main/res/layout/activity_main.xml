<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <!-- 信息栏（顶部） -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:background="@color/surface_overlay"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStorage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_sm"
            android:text="--" />

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_sm"
            android:text="--" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_sm"
            android:text="--" />

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvEncoding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_sm"
            android:text="H264 1080P" />

    </LinearLayout>

    <!-- 摄像头预览 -->
    <SurfaceView
        android:id="@+id/surfacePreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/infoBar"
        app:layout_constraintBottom_toTopOf="@id/gpsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 切换摄像头按钮（预览区右上角） -->
    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_margin="@dimen/space_md"
        android:src="@android:drawable/ic_menu_camera"
        android:background="#80000000"
        android:scaleType="centerInside"
        android:padding="@dimen/space_md"
        android:contentDescription="切换摄像头"
        app:layout_constraintTop_toBottomOf="@id/infoBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 推流状态覆盖层（预览区左上角） -->
    <TextView
        android:id="@+id/tvStreamStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_sm"
        android:textStyle="bold"
        android:background="#B3000000"
        android:text="● 初始化"
        android:layout_margin="@dimen/space_sm"
        app:layout_constraintTop_toBottomOf="@id/infoBar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 录像指示器（预览区右上角，对齐切换镜头按钮下方） -->
    <TextView
        android:id="@+id/tvRecordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        android:textColor="@color/status_recording"
        android:textSize="@dimen/font_md"
        android:textStyle="bold"
        android:background="#B3000000"
        android:text="● REC 00:00"
        android:visibility="gone"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_sm"
        app:layout_constraintTop_toBottomOf="@id/btnSwitchCamera"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 音频录制指示器（屏幕顶部醒目横幅） -->
    <TextView
        android:id="@+id/tvAudioRecordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_xxl"
        android:textStyle="bold"
        android:background="@drawable/bg_audio_indicator"
        android:text="🎙 录音中 00:00"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_lg"
        app:layout_constraintTop_toBottomOf="@id/infoBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GPS + 设备信息栏 -->
    <LinearLayout
        android:id="@+id/gpsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:background="@color/surface_overlay"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_sm"
            android:text="GPS: --" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_sm"
            android:text="--" />

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_sm"
            android:text="--" />

    </LinearLayout>

    <!-- 底部 4 键 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottombar_height"
        android:orientation="horizontal"
        android:background="@color/surface_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackground"
            android:scaleType="centerInside"
            android:padding="@dimen/space_md"
            android:contentDescription="设置" />

        <ImageButton
            android:id="@+id/btnLight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_light"
            android:background="?attr/selectableItemBackground"
            android:scaleType="centerInside"
            android:padding="@dimen/space_md"
            android:contentDescription="灯光" />

        <ImageButton
            android:id="@+id/btnPlayback"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_playback"
            android:background="?attr/selectableItemBackground"
            android:scaleType="centerInside"
            android:padding="@dimen/space_md"
            android:contentDescription="回放" />

        <ImageButton
            android:id="@+id/btnFunction"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_function"
            android:background="?attr/selectableItemBackground"
            android:scaleType="centerInside"
            android:padding="@dimen/space_md"
            android:contentDescription="功能" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
