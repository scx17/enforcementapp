<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="@dimen/space_xl"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📞 来电"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_xl"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCaller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/font_md"
        android:layout_marginTop="@dimen/space_md"
        android:text="指挥中心" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center">

        <Button
            android:id="@+id/btnDecline"
            style="@style/AppButton.Danger"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:text="拒接"
            android:layout_marginEnd="@dimen/space_md" />

        <Button
            android:id="@+id/btnAccept"
            style="@style/AppButton.Success"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:text="接听"
            android:layout_marginStart="@dimen/space_md" />

    </LinearLayout>

</LinearLayout>
