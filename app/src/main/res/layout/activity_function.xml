<?xml version="1.0" encoding="utf-8"?>
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:columnCount="2"
    android:rowCount="3"
    android:padding="16dp">

    <!-- 文件上传 -->
    <LinearLayout
        android:id="@+id/btnFileUpload"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">
        <TextView android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:textSize="28sp" android:text="📤"
            android:background="#1A237E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="文件上传" android:textColor="#FFFFFF" android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 集群对讲 -->
    <LinearLayout
        android:id="@+id/btnGroupIntercom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">
        <TextView android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:textSize="28sp" android:text="🎙"
            android:background="#1A237E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="集群对讲" android:textColor="#FFFFFF" android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 运行日志 -->
    <LinearLayout
        android:id="@+id/btnRunLog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">
        <TextView android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:textSize="28sp" android:text="📋"
            android:background="#1A237E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="运行日志" android:textColor="#FFFFFF" android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 平台通知 -->
    <LinearLayout
        android:id="@+id/btnNotification"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">
        <TextView android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:textSize="28sp" android:text="🔔"
            android:background="#1A237E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="平台通知" android:textColor="#FFFFFF" android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 单独拍照 -->
    <LinearLayout
        android:id="@+id/btnPhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">
        <TextView android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:textSize="28sp" android:text="📷"
            android:background="#1A237E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="单独拍照" android:textColor="#FFFFFF" android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 灯光控制 -->
    <LinearLayout
        android:id="@+id/btnLightControl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">
        <TextView android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:textSize="28sp" android:text="💡"
            android:background="#1A237E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="灯光控制" android:textColor="#FFFFFF" android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

</GridLayout>
