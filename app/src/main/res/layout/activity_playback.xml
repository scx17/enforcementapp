<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_bg">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_card"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:elevation="@dimen/elev_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="文件回放"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_xl"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvFileCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_md" />

    </LinearLayout>

    <!-- Tab 选项卡 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="@color/surface_card"
        app:tabTextColor="@color/text_tertiary"
        app:tabSelectedTextColor="@color/accent_blue"
        app:tabIndicatorColor="@color/accent_blue"
        app:tabIndicatorHeight="@dimen/stroke_thick"
        app:tabTextAppearance="@style/PlaybackTabText"
        app:tabRippleColor="@color/ripple_light" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部操作栏 -->
    <LinearLayout
        android:id="@+id/uploadBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bottombar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm"
        android:background="@color/surface_card">

        <!-- 正常模式 -->
        <LinearLayout
            android:id="@+id/normalBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnUploadAll"
                style="@style/AppButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="全部上传" />

            <Button
                android:id="@+id/btnManage"
                style="@style/AppButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_md"
                android:text="管理"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/accent_orange" />

            <TextView
                android:id="@+id/tvUploadTip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/font_sm"
                android:text="点击单个文件的上传按钮或全部上传" />

        </LinearLayout>

        <!-- 管理模式（默认隐藏） -->
        <LinearLayout
            android:id="@+id/manageBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnDeleteSelected"
                style="@style/AppButton.Danger"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="删除选中 (0)"
                android:enabled="false" />

            <Button
                android:id="@+id/btnSelectAll"
                style="@style/AppButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_md"
                android:text="全选" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCancelManage"
                style="@style/AppButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="取消" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
