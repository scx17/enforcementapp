<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/list_row_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- 批量选择 CheckBox（默认隐藏，管理模式下显示） -->
    <CheckBox
        android:id="@+id/cbSelect"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginEnd="@dimen/space_sm"
        android:visibility="gone"
        android:buttonTint="@color/accent_blue" />

    <!-- 缩略图 -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/surface_elevated" />

        <!-- 视频时长标识 -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="#B3000000"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_xs"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone" />

        <!-- 播放图标覆盖（仅视频） -->
        <ImageView
            android:id="@+id/ivPlayIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            android:alpha="0.85"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/space_md">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_md"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvFileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_sm"
            android:layout_marginTop="@dimen/space_xs" />

    </LinearLayout>

    <!-- 上传状态区域 -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <Button
            android:id="@+id/btnUpload"
            style="@style/AppButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:minWidth="72dp"
            android:text="上传"
            android:textSize="@dimen/font_sm"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <ProgressBar
            android:id="@+id/progressUpload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="72dp"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="center"
            android:max="100"
            android:visibility="gone" />

        <!-- 已上传状态：文字 + 删除按钮 -->
        <LinearLayout
            android:id="@+id/layoutUploaded"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUploaded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已上传"
                android:textSize="@dimen/font_sm"
                android:textColor="@color/accent_green" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_xs"
                android:src="@drawable/ic_delete"
                android:contentDescription="删除"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:padding="@dimen/space_md" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
