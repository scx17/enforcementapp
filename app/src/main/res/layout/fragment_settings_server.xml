<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 平台地址 -->
        <TextView android:text="平台 API 地址" android:textColor="#FFFFFF" android:textSize="14sp"
            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etApiUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="http://192.168.1.100:5004" android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:background="#2A2A3E" android:padding="8dp" android:layout_marginBottom="8dp"
            android:inputType="textUri" />

        <Button android:id="@+id/btnAutoConfig"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="从平台自动获取以下配置" android:backgroundTint="#0D47A1" android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />
        <TextView android:text="输入平台地址后点击上方按钮可自动填充，也可手动修改以下参数连接其他平台"
            android:textColor="#888888" android:textSize="11sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- 分隔线 -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#333355" android:layout_marginBottom="12dp" />

        <!-- SIP 服务器地址 -->
        <TextView android:text="SIP 服务器地址" android:textColor="#CCCCCC" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etSipServer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="与平台同一IP" android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:background="#2A2A3E" android:padding="8dp" android:layout_marginBottom="10dp" />

        <!-- SIP 端口 -->
        <TextView android:text="SIP 端口" android:textColor="#CCCCCC" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etSipPort" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="5060" android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:background="#2A2A3E" android:padding="8dp" android:layout_marginBottom="10dp" />

        <!-- 设备编码 -->
        <TextView android:text="设备编码（SIP 账号）" android:textColor="#CCCCCC" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="自动配置时根据设备 SN 生成，连接其他平台时可手动修改"
            android:textColor="#666666" android:textSize="11sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etSipUsername" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="20位国标设备编码" android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:background="#2A2A3E" android:padding="8dp" android:layout_marginBottom="10dp" />

        <!-- SIP 密码 -->
        <TextView android:text="SIP 密码" android:textColor="#CCCCCC" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etSipPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="admin123" android:inputType="textVisiblePassword" android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:background="#2A2A3E" android:padding="8dp" android:layout_marginBottom="10dp" />

        <!-- 分隔线 -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#333355" android:layout_marginBottom="12dp" />

        <!-- 日志上传间隔 -->
        <TextView android:text="日志上传间隔（秒）" android:textColor="#CCCCCC" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etLogInterval" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="60" android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:background="#2A2A3E" android:padding="8dp" android:layout_marginBottom="16dp" />

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="保存" android:backgroundTint="#1A237E" android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
