<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <TextView android:text="设备 ID" android:textColor="#AAAAAA" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etDeviceId" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textColorHint="#666666"
            android:background="#2A2A3E" android:padding="8dp" android:layout_marginBottom="12dp" />

        <TextView android:text="网络优先级" android:textColor="#AAAAAA" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioGroup android:id="@+id/rgNetwork" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp">
            <RadioButton android:id="@+id/rbWifi" android:text="WiFi 优先" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/rb4g" android:text="4G 优先" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </RadioGroup>

        <Button android:id="@+id/btnSaveSystem" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="保存" android:backgroundTint="#1A237E" android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
