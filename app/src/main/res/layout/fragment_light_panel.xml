<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="@dimen/space_lg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="灯光控制"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_lg"
        android:textStyle="bold"
        android:paddingBottom="@dimen/space_md" />

    <!-- 闪光灯 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="闪光灯"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_md" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 红外灯 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="红外灯"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_md" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchIR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 激光灯 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="激光灯"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_md" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLaser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 红蓝爆闪灯 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="红蓝爆闪"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_md" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchStrobe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 红色警示灯 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="红色警示灯"
            android:textColor="@color/accent_red"
            android:textSize="@dimen/font_md"
            android:textStyle="bold" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchRedStrobe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 蓝色警示灯 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="蓝色警示灯"
            android:textColor="@color/accent_blue"
            android:textSize="@dimen/font_md"
            android:textStyle="bold" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchBlueStrobe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
