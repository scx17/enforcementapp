<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- =========================================================
         执法仪 App · 命名 styles
         角色化、可复用；旧 layout 逐步迁移到 style="@style/AppXxx"
         ========================================================= -->

    <!-- ============== 顶栏 ============== -->
    <style name="AppToolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:background">@color/surface_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:elevation">@dimen/elev_card</item>
    </style>

    <style name="AppToolbar.Title">
        <item name="android:textSize">@dimen/font_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ============== 文本 ============== -->
    <style name="AppText" />

    <style name="AppText.Title">
        <item name="android:textSize">@dimen/font_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppText.Heading">
        <item name="android:textSize">@dimen/font_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppText.Body">
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AppText.Label">
        <item name="android:textSize">@dimen/font_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="AppText.Hint">
        <item name="android:textSize">@dimen/font_sm</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="AppText.Value">
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- ============== 按钮 ============== -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="AppButton.Primary">
        <item name="backgroundTint">@color/accent_blue</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AppButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="AppButton.Danger">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="backgroundTint">@color/accent_red</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="AppButton.Success">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="backgroundTint">@color/accent_green</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="AppButton.Icon">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <!-- ============== 列表行 ============== -->
    <style name="AppListRow">
        <item name="android:minHeight">@dimen/list_row_min</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- ============== 状态徽章 ============== -->
    <style name="AppStatusBadge">
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ============== 对话框 ============== -->
    <style name="AppDialog" />

    <style name="AppDialog.Title">
        <item name="android:textSize">@dimen/font_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
    </style>

    <!-- ============== 输入框 ============== -->
    <style name="AppInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border_strong</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- 兼容已有 PlaybackTabText -->
    <style name="PlaybackTabText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">@dimen/font_md</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
